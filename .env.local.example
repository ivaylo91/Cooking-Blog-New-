# Copy this file to .env.local and fill in the values from your Supabase
# project (Project Settings > API).

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The production address, used for canonicals, the sitemap, Open Graph and
# JSON-LD. On Vercel the project's production domain is used if this is unset.
NEXT_PUBLIC_SITE_URL=https://www.cookingblogofivo.com

# A long random secret for hashing visitor IPs (comment rate limits, one
# rating per visitor). Never commit the real value.
IP_HASH_SALT=generate-a-long-random-string
